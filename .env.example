# Copy to .env and fill in. .env is gitignored.

# Used for JD relevance scoring, resume tailoring and drafted form answers.
# Set one of these. With both set, Anthropic wins unless you say otherwise.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...

# anthropic | openai. Inferred from whichever key is set, so you only need
# this when both are.
# SHOTGUN_PROVIDER=anthropic

# Where the browser profile lives. Log into LinkedIn/Workday/etc once by hand
# in this profile and the session persists across runs.
SHOTGUN_BROWSER_PROFILE=~/.shotgun/chrome-profile

# Set to 1 to run the browser headless. Leave unset while you are still
# debugging fillers — you want to watch what it does.
SHOTGUN_HEADLESS=

# Optional: override the model. Defaults to claude-opus-5 or gpt-5 depending
# on the provider. A name belonging to the other provider is ignored, so this
# does not have to be edited when switching.
SHOTGUN_MODEL=claude-opus-5
